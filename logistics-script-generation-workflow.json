    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"record_id\": $json.record_id, \"status\": \"Script generated and updated\" } }}",
        "options": {}
      },
      "id": "webhook-response-001",
      "name": "返回Webhook响应",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
